{
  "name": "expense-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "expense-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    9
  ],
  "description": "The single web app every actor signs into: employees submit claims and track their status, managers review and decide claims from their team, and finance reviews and exports approved claims. Holds no data of its own — every read and write goes through expense-api.",
  "dependencies": [
    {
      "kind": "component",
      "name": "expense-api",
      "wiring": {
        "endpoint": {
          "component": "employees-submit-expense-v4-expense-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "EXPENSE_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "employees-submit-c850a250",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
