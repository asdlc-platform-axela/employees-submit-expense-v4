{
  "name": "expense-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "expense-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8,
    9
  ],
  "description": "Owns expense claims and their approval lifecycle: employees submit claims, managers approve or reject the claims of employees reporting to them, and finance lists and exports approved, unexported claims. Stores claims, receipts and the manager relationship. Does not send email itself beyond calling email-service, and does not talk to a payroll system directly — it only produces an export file.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "expense-db",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "employees-submit-e9dce28d",
        "envBindings": {
          "dbname": "EXPENSE_DB_DBNAME",
          "host": "EXPENSE_DB_HOST",
          "password": "EXPENSE_DB_PASSWORD",
          "port": "EXPENSE_DB_PORT",
          "user": "EXPENSE_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "employees-submit-c850a250",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    },
    {
      "kind": "external",
      "name": "email-service",
      "description": "Sends the employee decision email and the manager new-claim email.",
      "wiring": {
        "ref": "employees-submit-6d6ed892",
        "envBindings": {
          "SENDGRID_API_KEY": "SENDGRID_API_KEY",
          "SENDGRID_FROM_EMAIL": "SENDGRID_FROM_EMAIL"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
